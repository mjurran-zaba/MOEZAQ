            <p class="story-para">
              I finished the tutorial at 18 in an Islamic Senior High School, and along the way, I unlocked two more languages: English and Arabic. So now I speak three languages in total, with Indonesian as my first language.
            </p>

            <p class="story-para">
              Right now, I'm still grinding and hunting for money to get better items, and grinding my skills in tech, Artificial Intelligence, coding fundamentals, and more.
            </p>

            <p class="story-quote">
              My advice? &ldquo;If they can, why must it be us?&rdquo;.
            </p>
          </div>


        </article>

      </div>



    </div>

  </div>

  <script is:inline>
    const topbarEl = document.getElementById("topbar-44");
    const aboutPhotoCard = document.getElementById("about-photo-card");
    const aboutHeroCard = document.getElementById("about-hero-card");
    const aboutDividerTop = document.getElementById("about-divider-top");
    const aboutStoryCard = document.getElementById("about-story-card");
    const quickCards = document.querySelectorAll(".about-quick-card");

    const drawerPanel = document.getElementById("drawer-panel");
    const drawerBackdrop = document.getElementById("drawer-backdrop");

    // FORWARD WHEEL & TOUCH SCROLL FROM PINNED HERO ROW TO BOTTOM SCROLL ZONE
    const pinnedHeroRow = document.getElementById("about-hero-row");
    const bottomScrollZone = document.getElementById("about-bottom-zone");

    if (pinnedHeroRow && bottomScrollZone) {
      pinnedHeroRow.addEventListener("wheel", (e) => {
        bottomScrollZone.scrollTop += e.deltaY;
      }, { passive: true });

      let touchStartY = 0;
      pinnedHeroRow.addEventListener("touchstart", (e) => {
        if (e.touches && e.touches.length > 0) {
          touchStartY = e.touches[0].clientY;
        }
      }, { passive: true });

      pinnedHeroRow.addEventListener("touchmove", (e) => {
        if (e.touches && e.touches.length > 0) {
          const currentY = e.touches[0].clientY;
          const diff = touchStartY - currentY;
          bottomScrollZone.scrollTop += diff;
          touchStartY = currentY;
        }
      }, { passive: true });
    }

    // SPAWN SINKRON PORTFOLIO (LUXURIOUS NATURAL GLIDE & SEQUENTIAL QUICK CARDS)
    function runPortfolioSpawn() {
      // Topbar muncul lembut
      topbarEl.classList.add("revealed");

      // Wave 1: Kartu Foto (smooth faded zoom out) + Hero Quote Card + Garis Pembatas (60ms)
      setTimeout(() => {
        aboutPhotoCard.classList.add("revealed");
        aboutHeroCard.classList.add("revealed");
        if (aboutDividerTop) aboutDividerTop.classList.add("revealed");

        // Wave 2: Story Card biografi RPG meluncur halus ke posisinya (200ms)
        setTimeout(() => {
          aboutStoryCard.classList.add("revealed");

          // Wave 3: 6 Quick Cards meluncur bergantian satu per satu secara berurutan & smooth (interval 110ms)
          setTimeout(() => {
            quickCards.forEach((card, idx) => {
              setTimeout(() => {
                card.classList.add("revealed");
              }, idx * 110);
            });
          }, 110);

        }, 180);

      }, 60);
    }

    // INTERAKSI ACCORDION QUICK CARDS
    function setupQuickCardsAccordion() {
      quickCards.forEach(card => {
        card.addEventListener("click", (e) => {
          e.stopPropagation();
          const isExpanded = card.classList.contains("is-expanded");
          
          quickCards.forEach(c => {
            if (c !== card) {
              c.classList.remove("is-expanded");
              c.setAttribute("aria-expanded", "false");
            }
          });

          if (isExpanded) {
            card.classList.remove("is-expanded");
            card.setAttribute("aria-expanded", "false");
          } else {
            card.classList.add("is-expanded");
            card.setAttribute("aria-expanded", "true");
          }

          if (navigator.vibrate) navigator.vibrate(8);
        });

        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            card.click();
          }
        });
      });
    }

    // DRAWER COMMISSIONS ACCORDION TOGGLE
    function setupDrawerCommissionsAccordion() {
      const commCard = document.getElementById("drawer-comm-card");
      if (!commCard) return;

      commCard.addEventListener("click", (e) => {
        if (e.target.closest("a")) return;
        const isExpanded = commCard.classList.contains("is-expanded");
        if (isExpanded) {
          commCard.classList.remove("is-expanded");
          commCard.setAttribute("aria-expanded", "false");
        } else {
          commCard.classList.add("is-expanded");
          commCard.setAttribute("aria-expanded", "true");
        }
        if (navigator.vibrate) navigator.vibrate(8);
      });

      commCard.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          commCard.click();
        }
      });
    }

    // DRAWER PANEL TOGGLE (0ms pointerdown)
    function toggleDrawer(open) {
      if (open) {
        drawerPanel.classList.add("open");
        drawerBackdrop.classList.add("active");
        if (navigator.vibrate) navigator.vibrate(10);
      } else {
        drawerPanel.classList.remove("open");
        drawerBackdrop.classList.remove("active");
        if (navigator.vibrate) navigator.vibrate(8);
      }
    }

    window.toggleDrawer = toggleDrawer;

    // TACTILE FEEDBACK PADA ELEMEN INTERAKTIF
    function setupTactileFeedback() {
      const interactiveEls = document.querySelectorAll(".btn-topbar-panel, .story-link-item, .about-quick-card, .drawer-comm-card, .drawer-comm-btn, .btn-drawer-close");
      interactiveEls.forEach(card => {
        const pressOn = () => card.classList.add("is-pressed");
        const pressOff = () => setTimeout(() => card.classList.remove("is-pressed"), 80);

        card.addEventListener("pointerdown", pressOn);
        card.addEventListener("pointerup", pressOff);
        card.addEventListener("pointercancel", pressOff);
        card.addEventListener("pointerleave", pressOff);
      });
    }

    window.addEventListener("DOMContentLoaded", () => {
      runPortfolioSpawn();
      setupQuickCardsAccordion();
      setupDrawerCommissionsAccordion();
      setupTactileFeedback();

      const btnPanel = document.getElementById("btn-topbar-panel");
      if (btnPanel) {
        btnPanel.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          toggleDrawer(true);
        });
      }

      const btnDrawerClose = document.querySelector(".btn-drawer-close");
      if (btnDrawerClose) {
        btnDrawerClose.addEventListener("pointerdown", (e) => {
          e.preventDefault();
          toggleDrawer(false);
        });
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawerPanel && drawerPanel.classList.contains("open")) {
        toggleDrawer(false);
      }
    });
  </script>

</body>
</html>
