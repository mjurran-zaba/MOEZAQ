      position: relative;
      flex-shrink: 0;
      z-index: 10;
    }

    /* KARTU FOTO (TOP-LEFT): FADED ZOOM OUT (FADED WHITE MILK 45%) */
    .about-photo-card {
      flex: 0 0 126px;
      width: 126px;
      height: 171px;
      border-radius: 20px;
      padding: 8px; /* space tipis agar tetap elegan */
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      user-select: none;
      -webkit-user-select: none;

      /* Faded White Milk Glassmorphism 45% */
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.08) 100%),
        rgba(16, 22, 32, 0.45);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.24);

      box-shadow:
        0 16px 36px -8px rgba(0, 0, 0, 0.72),
        inset 1.5px 1.5px 2.5px rgba(255, 255, 255, 0.32),
        inset -2px -2px 5px rgba(0, 0, 0, 0.38);

      /* Spawn Logic: Smooth Faded Zoom Out */
      opacity: 0;
      transform: scale(1.15);
      will-change: transform, opacity;
      transition:
