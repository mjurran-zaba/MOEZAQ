    /*
      BAGIAN BAWAH ABOUT ME: SCROLLABLE INTERNAL VIEWPORT
      Kartu di bawah garis pembatas dapat di-scroll lancar, dan ketika menyentuh
      garis pembatas akan memudar halus (efek tertelan kabut obsidian).
    */
    .about-bottom-zone {
      width: 100%;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-y: contain;
      padding-top: 6px;
      padding-bottom: 28px;
      mask-image: linear-gradient(to bottom, transparent 0px, black 14px, black 100%);
