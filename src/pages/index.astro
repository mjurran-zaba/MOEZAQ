      box-sizing: border-box !important;
      overflow: hidden !important;
      box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.55) !important;
    }

    .about-quick-card.is-expanded {
      height: auto !important;
      min-height: 36px !important;
      max-height: none !important;
      overflow: hidden !important;
    }

    .quick-card-header {
      width: 100%;
      height: 34px;
      min-height: 34px;
      box-sizing: border-box;
      padding: 0 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .about-quick-card.is-expanded .quick-card-header {
      height: 36px;
      min-height: 36px;
    }

    /* Saat card tertutup: body 100% display: none dan mutlak dikeluarkan dari layout tree */
    .about-quick-card:not(.is-expanded) .quick-card-body {
      display: none !important;
      height: 0 !important;
      min-height: 0 !important;
      max-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      overflow: hidden !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    .about-quick-card:not(.is-expanded) .quick-card-body-inner {
      display: none !important;
      height: 0 !important;
      min-height: 0 !important;
      max-height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      overflow: hidden !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    /* Saat card terbuka: tampil dengan animasi expand halus, alami & anggun */
    .about-quick-card.is-expanded .quick-card-body {
      display: block !important;
      height: auto !important;
      min-height: 0 !important;
      overflow: hidden !important;
      visibility: visible !important;
      opacity: 1 !important;
      animation: quickCardExpand 0.40s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .quick-card-body-inner {
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 6px 14px 12px 14px;
      border-top: 1px dashed rgba(255, 255, 255, 0.14);
    }

    .about-quick-card.is-expanded .quick-card-body-inner {
      display: flex !important;
      height: auto !important;
      min-height: 0 !important;
      overflow: hidden !important;
      visibility: visible !important;
      opacity: 1 !important;
      animation: quickBodyInnerFade 0.38s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes quickCardExpand {
      0% {
        opacity: 0;
        max-height: 0;
        transform: translateY(-8px);
      }
      100% {
        opacity: 1;
        max-height: 380px;
        transform: translateY(0);
      }
    }

    @keyframes quickBodyInnerFade {
      0% {
        opacity: 0;
      }
      40% {
        opacity: 0.35;
      }
      100% {
        opacity: 1;
      }
    }

