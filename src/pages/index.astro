    /* CARD BIOGRAFI RPG: TINGGI PAS SAMPAI LINK PALING BAWAH + SEDIKIT SPACE (FADED WHITE CLOUD GLASSMORPHISM 30%) */
    .about-story-card {
      flex: 0 0 calc(50% - 6px);
      width: calc(50% - 6px);
      height: auto;
      border-radius: 18px;
      padding: 14px 16px 14px 16px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      user-select: none;
      -webkit-user-select: none;

      /* Faded White Cloud Glassmorphism 30% */
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0.05) 100%),
        rgba(16, 22, 32, 0.30);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.18);

      box-shadow:
        0 14px 32px -8px rgba(0, 0, 0, 0.65),
        inset 1.5px 1.5px 2px rgba(255, 255, 255, 0.25),
        inset -1.5px -1.5px 4px rgba(0, 0, 0, 0.35);

      /* Spawn Logic: Smooth Slide to Left */
      opacity: 0;
      transform: translate3d(36px, 0, 0);
      will-change: transform, opacity;
      transition:
        opacity 0.90s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.90s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .about-story-card::-webkit-scrollbar {
      display: none;
    }

    .about-story-card.revealed {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }



    .about-story-header {
      display: flex;
