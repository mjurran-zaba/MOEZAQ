    .theme-gallery-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 120;

      background:
        radial-gradient(ellipse at 50% 12%, rgba(255, 255, 255, 0.22) 0%, transparent 75%),
