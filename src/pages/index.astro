      object-position: center 15%;
      display: block;
      border-radius: 13px;
    }

    /* HERO CARD: SLIDE TO LEFT MENDEKATI FOTO (FADED WHITE MILK GLASSMORPHISM 45%) */
    .about-hero-card {
      flex: 1;
      min-width: 0;
      min-height: 171px;
      border-radius: 20px;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      user-select: none;
      -webkit-user-select: none;

      /* Faded White Milk Glassmorphism 45% */
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.08) 100%),
        rgba(16, 22, 32, 0.45);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.24);

      box-shadow:
        0 16px 36px -8px rgba(0, 0, 0, 0.72),
        inset 1.5px 1.5px 2.5px rgba(255, 255, 255, 0.32),
        inset -2px -2px 5px rgba(0, 0, 0, 0.38);

      /* Spawn Logic: Smooth Slide to Left */
      opacity: 0;
      transform: translate3d(36px, 0, 0);
      will-change: transform, opacity;
      transition:
        opacity 0.90s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.90s cubic-bezier(0.22, 1, 0.36, 1);
